# LightFlux API — production environment template.
#
# Copy to `server/.env` ON THE SERVER and fill in real values. This file is a
# template only: never commit real secrets. Secrets live exclusively on the
# server (and in GitHub Actions secrets for automated deploys).

# --- HTTP / origins -------------------------------------------------------
PORT=8787
# Public HTTPS origin. Drives the Better Auth base URL and the `Secure` cookie
# flag, so it MUST be https:// once nginx terminates TLS.
PUBLIC_BASE_URL=https://lightflux.site
APP_WEB_URL=https://lightflux.site
# Origins allowed to call the API with credentials (Web, Tauri, local dev).
CORS_ORIGIN=https://lightflux.site,http://localhost:8081,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
AUTH_TRUSTED_ORIGINS=https://lightflux.site,http://localhost:8081,http://localhost:1420
# nginx is the only public path, so trust its forwarded client IP.
AUTH_IP_ADDRESS_HEADERS=x-forwarded-for
AUTH_TRUSTED_PROXIES=127.0.0.1

# --- Secrets (>= 32 random characters each) -------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32+-random-characters
BETTER_AUTH_SECRET=replace-with-another-32+-random-secret

# --- Database (Supabase PostgreSQL, Session pooler) -----------------------
# Use the Session pooler connection string (port 5432) for a persistent Node
# process. DATABASE_SSL must stay true for hosted databases.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_MAX_CONNECTIONS=10

# --- Email OTP delivery (Resend SMTP) -------------------------------------
# lightflux.site is verified in Resend. Keep the production sender on that
# verified domain so OTP mail can reach recipients beyond the Resend owner.
OTP_DELIVERY=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM=LightFlux <noreply@lightflux.site>

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=8388608
UPLOAD_ALLOW_ANONYMOUS=false

# --- AI proxy (OpenAI-compatible) -----------------------------------------
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-key
AI_MODEL=deepseek-v4-flash
AI_ALLOW_ANONYMOUS=false
