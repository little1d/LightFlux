# Public auth API. Development can derive the Metro host; production must set it.
EXPO_PUBLIC_AUTH_API_URL=http://localhost:8787
# Local upload API. May point to a separate service in production.
EXPO_PUBLIC_UPLOAD_API_URL=http://localhost:8787
# AI Agent orchestrator API. May share the auth API origin.
EXPO_PUBLIC_AI_API_URL=http://localhost:8787
