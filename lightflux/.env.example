# LightFlux desktop and Expo Web run entirely locally and need no environment
# variables. Copying this file to `.env` changes nothing.
#
# The variables below only exist so the archived cloud client code still
# compiles. `npm run desktop:web`, `npm run desktop:dev` and desktop builds
# ignore them on purpose (see scripts/export-desktop.mjs), so they must never
# be required for a local workflow.
#
# EXPO_PUBLIC_AUTH_API_URL=http://localhost:8787
# EXPO_PUBLIC_UPLOAD_API_URL=http://localhost:8787
# EXPO_PUBLIC_AI_API_URL=http://localhost:8787
