{
  "name": "lightflux",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "desktop:web": "expo export --platform web --output-dir desktop-dist",
    "editor:build": "vite --config ./editor-web/vite.config.ts build && npm run editor:postbuild",
    "editor:postbuild": "node ./node_modules/@10play/tentap-editor/scripts/buildEditor.js ./editor-web/build/index.html ./editor-web/build/editorHtml.js",
    "ios": "expo start --ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "expo": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "lunar-typescript": "^1.8.6",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "tailwindcss": "3.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
