{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightFlux",
  "version": "1.0.0",
  "identifier": "com.little1d.lightflux",
  "build": {
    "beforeDevCommand": "npm run web -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:web",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "LightFlux",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A focused task manager for daily planning.",
    "longDescription": "LightFlux is a focused task manager for daily planning, projects, calendars, priorities, and rich task notes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/little1d/lightflux-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQkU0MTYwQ0FGRDZDOEQKUldTTmJQM0tZRUcrWVpTSmFOR0RGRkc1Q1crUkU5aFNNYURTU3dzRThVTUVnL1hlMktsQzlDeG4K"
    }
  }
}
