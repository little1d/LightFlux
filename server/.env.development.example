# LightFlux API — 本地开发环境模板（development）。
#
# 用法：复制为 server/.env 并填入你的 **dev** 资源值（本机运行时只加载 .env）。
# 铁律：本机开发默认指向 DEV 资源，绝不复用生产密钥。生产值只存在于服务器
# 和 GitHub Actions secrets。需要本地手动运维生产库时，见 deploy/ENVIRONMENTS.md
# 的"本地生产运维"约定，用独立的 .env.production.local，切勿写进日常 .env。
# 完整规范见 deploy/ENVIRONMENTS.md。

# --- HTTP / origins -------------------------------------------------------
PORT=8787
NODE_ENV=development
# 本地 API 自身地址（http 即可，本地不用 TLS）。
PUBLIC_BASE_URL=http://localhost:8787
APP_WEB_URL=http://localhost:8081
# 允许携带凭据调用本地 API 的来源：Expo Web、Tauri dev。
CORS_ORIGIN=http://localhost:8081,http://localhost:1420,tauri://localhost,http://tauri.localhost
# Radon / Expo Go 使用带动态端口的 exp:// Origin；Better Auth 支持按协议信任。
AUTH_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:1420,exp://
# 本地不经反代，留空。
AUTH_IP_ADDRESS_HEADERS=
AUTH_TRUSTED_PROXIES=

# --- Secrets（各环境独立生成，勿复用生产密钥）-----------------------------
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-replace-with-32+-random-characters
BETTER_AUTH_SECRET=dev-only-replace-with-another-32+-random-secret

# --- Database（DEV Supabase 项目，Session pooler；绝不指向生产库）----------
# DEV 项目：把占位符替换为开发数据库项目 ID、区域和密码。
# Session pooler（5432）适配常驻 Node 进程；托管库 DATABASE_SSL 必须为 true。
DATABASE_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_MAX_CONNECTIONS=10

# --- Email OTP（本地不发真实邮件）-----------------------------------------
# log：验证码直接打印到服务端日志，方便本地登录调试。
# 想验证真实邮件链路时改用本地 MailHog：OTP_DELIVERY=smtp / SMTP_HOST=localhost / SMTP_PORT=1025。
OTP_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# `log` 模式不会读取发件地址；MailHog 也只在本机接收，避免在开发环境复用生产 sender。
SMTP_FROM=LightFlux <no-reply@localhost>

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=8388608
# 本地允许匿名上传以简化调试；共享/付费环境必须为 false。
UPLOAD_ALLOW_ANONYMOUS=true

# --- AI proxy（OpenAI 兼容）-----------------------------------------------
# 用独立/低配额 key，避免消耗生产额度；本地可开匿名简化调试。
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-dev-key
AI_MODEL=deepseek-v4-flash
AI_ALLOW_ANONYMOUS=true
