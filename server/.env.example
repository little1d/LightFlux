PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
APP_WEB_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8081,http://localhost:1420,tauri://localhost,http://tauri.localhost
SESSION_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_SECRET=replace-with-another-32-character-random-secret
# Comma-separated Web, Tauri, and app origins allowed to start auth requests.
AUTH_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:1420
# Set these only when the API is reachable exclusively through your proxy.
AUTH_IP_ADDRESS_HEADERS=
AUTH_TRUSTED_PROXIES=
DATABASE_URL=postgresql://lightflux:lightflux@localhost:5432/lightflux
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Used only by `npm run db:import-json` when migrating the old repository.
DATA_FILE=./data/auth.json

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=8388608
# Local development only. Keep false when authentication is configured.
UPLOAD_ALLOW_ANONYMOUS=false

# Use "log" only for local development. SES and other providers use "smtp".
OTP_DELIVERY=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LightFlux <no-reply@example.com>

# OpenAI-compatible API root before /chat/completions.
# Examples: https://api.deepseek.com or https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=20
# Local development only. Keep false for paid/shared environments.
AI_ALLOW_ANONYMOUS=false

# Website application approved in WeChat Open Platform.
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:8787/api/auth/wechat/web/callback

# Mobile application approved in WeChat Open Platform.
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=
