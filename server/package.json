{
  "name": "lightflux-auth-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:import-json": "node --env-file-if-exists=.env src/postgres/import-json-cli.mjs",
    "db:migrate": "node --env-file-if-exists=.env src/postgres/migrate-cli.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/index.mjs",
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test tests/postgres-live.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
